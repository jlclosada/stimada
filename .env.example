# Copy this file to .env and fill in the values

# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=stimada
POSTGRES_USER=stimada
POSTGRES_PASSWORD=stimada
DATABASE_URL=postgres://stimada:stimada@db:5432/stimada

# Email (for local dev, uses console backend by default)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Stimada <no-reply@stimada.com>

# Frontend
NUXT_PUBLIC_API_BASE=http://localhost:8000
